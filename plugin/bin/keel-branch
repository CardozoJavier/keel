#!/bin/bash
# keel-branch (contracts/run-state.md): local-only feature branching. Never fetches, ls-remotes or
# updates remotes (the Spec Kit create-new-feature script does; keel doesn't vendor it).
#   keel-branch next-number          → NNN=<1 + max(specs/NNN-* dirs, local NNN-* branches)>
#   keel-branch ensure <NNN-name>    → BRANCH= BASE= CREATED=yes|no STACKED=<branch>|no
#   keel-branch default              → DEFAULT=<default branch>
# ensure halts (exit 3, MISSING=clean-tree) on any change outside the ensure-scope exemptions:
#   .specify/feature.json always; specs/<feature>/** and .specify/memory/constitution.md when keel
#   wrote them (ledger "files done" rows) or when HEAD is already the branch named <feature>.
set -u
_s=$0; while [ -h "$_s" ]; do _d=$(cd -P "$(dirname "$_s")" && pwd); _s=$(readlink "$_s"); case $_s in /*) ;; *) _s=$_d/$_s ;; esac; done
. "${KEEL_ROOT:-$(cd -P "$(dirname "$_s")/.." && pwd)}/lib/bin-preamble.sh" || exit 5
LEDGER="$(keel_root)/bin/keel-ledger"

root=$(keel_repo_root)
cd "$root" || exit 5

default_branch() {
  local ref b
  if ref=$(git symbolic-ref -q refs/remotes/origin/HEAD 2>/dev/null); then
    printf '%s\n' "${ref#refs/remotes/origin/}"; return
  fi
  b=$(git config --get init.defaultBranch 2>/dev/null)
  if [ -n "$b" ]; then printf '%s\n' "$b"; return; fi
  for b in main master; do
    if git show-ref -q --verify "refs/heads/$b"; then printf '%s\n' "$b"; return; fi
  done
  printf 'main\n'
}

current_branch() { git symbolic-ref -q --short HEAD 2>/dev/null; }

case "${1:-}" in
  next-number)
    max=0
    for d in specs/[0-9][0-9][0-9]-*; do
      [ -d "$d" ] || continue
      n=${d#specs/}; n=${n%%-*}; n=$((10#$n)); [ "$n" -gt "$max" ] && max=$n
    done
    for b in $(git for-each-ref --format='%(refname:short)' 'refs/heads/[0-9][0-9][0-9]-*' 2>/dev/null); do
      n=${b%%-*}; n=$((10#$n)); [ "$n" -gt "$max" ] && max=$n
    done
    printf 'NNN=%03d\n' $((max + 1))
    exit 0 ;;
  default)
    keel_emit DEFAULT "$(default_branch)"
    exit 0 ;;
  ensure) ;;
  *) keel_die 1 "usage: keel-branch next-number | ensure <NNN-name> | default" ;;
esac

feature=${2:-}
keel_feature_ok "$feature" || keel_die 1 "invalid feature name: $feature"
cur=$(current_branch)

# ensure-scope exemptions
ledgered=$("$LEDGER" rows "$feature" 2>/dev/null | awk -F'\t' '$2 == "files" && $3 == "done" { print $5 }')
exempt() {
  local p=$1 l
  [ "$p" = ".specify/feature.json" ] && return 0
  case "$p" in "specs/$feature/"* | ".specify/memory/constitution.md")
    [ "$cur" = "$feature" ] && return 0
    while IFS= read -r l; do
      [ -n "$l" ] || continue
      case "$p" in "$l" | "$l"/*) return 0 ;; esac
    done <<EOF
$ledgered
EOF
    ;;
  esac
  return 1
}
dirty=
while IFS= read -r line; do
  [ -n "$line" ] || continue
  path=${line#???}
  case "$path" in *' -> '*) path=${path#* -> } ;; esac
  case "$path" in \"*\") path=${path#\"}; path=${path%\"} ;; esac
  # porcelain lists an untracked directory as "dir/": exempt only if every file beneath is exempt
  if [ "${path%/}" != "$path" ]; then
    for f in $(git ls-files --others --exclude-standard -- "$path"); do exempt "$f" || dirty="$dirty $f"; done
  else
    exempt "$path" || dirty="$dirty $path"
  fi
done <<EOF
$(git status --porcelain=v1 2>/dev/null)
EOF
if [ -n "$dirty" ]; then
  printf 'MISSING=clean-tree\nDIRTY=%s\n' "${dirty# }"
  keel_die 3 "keel-branch: uncommitted changes outside $feature's own files; commit or discard them first:${dirty}"
fi

# base recorded for this feature, if any
recorded_base() { "$LEDGER" last "$feature" branch 2>/dev/null | awk -F'\t' '{ print $4 }'; }

created=no stacked=no
if ! git rev-parse -q --verify HEAD >/dev/null 2>&1; then
  # unborn repository: point HEAD at the feature branch; the base is the empty tree
  if [ "$cur" != "$feature" ]; then
    git symbolic-ref HEAD "refs/heads/$feature" || keel_die 5 "cannot set HEAD to $feature"
    created=yes
  fi
  base=$(keel_empty_tree)
elif [ "$cur" = "$feature" ]; then
  base=$(recorded_base)
elif git show-ref -q --verify "refs/heads/$feature"; then
  git switch -q "$feature" || keel_die 5 "cannot switch to $feature"
  base=$(recorded_base)
else
  case "$cur" in [0-9][0-9][0-9]-*) stacked=$cur ;; esac
  base=$(git rev-parse HEAD)
  git switch -q -c "$feature" || keel_die 5 "cannot create $feature"
  created=yes
fi
if [ -z "${base:-}" ]; then
  base=$(git merge-base HEAD "$(default_branch)" 2>/dev/null) || base=$(git rev-parse HEAD)
fi
if [ "$created" = yes ]; then
  if [ "$stacked" != no ]; then "$LEDGER" append "$feature" branch ok "$base" "$feature stacked-from $stacked"
  else "$LEDGER" append "$feature" branch ok "$base" "$feature"; fi
fi
keel_emit BRANCH "$feature"
keel_emit BASE "$base"
keel_emit CREATED "$created"
keel_emit STACKED "$stacked"
